<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Clean URL handling: if the static HTML file exists, rewrite to it
  # e.g., browser requests /about -> serve /about.html internally
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^([^/]+)$ $1.html [L]
  
  # For nested routes like /destinations/agra -> serve /destinations/agra.html internally
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]
  
  # Fallback: if file doesn't exist, route to index.html for client-side routing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.html [L]
</IfModule>
